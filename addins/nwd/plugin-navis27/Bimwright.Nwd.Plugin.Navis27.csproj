<Project Sdk="Microsoft.NET.Sdk">

  <!-- Navis-mcp: built from plugin-navis25 (which compiles) for Navisworks Manage 2027.
       Upstream's plugin-navis27 at v1.0.0 referenced a non-existent Autodesk.Navisworks.Api.Controls.dll
       and dropped the IsExternalInit package, so it did not build. -->

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Bimwright.Nwd.Plugin</RootNamespace>
    <AssemblyName>Bimwright.Nwd.Plugin.Navis27</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <NavisworksYear>2027</NavisworksYear>
    <DefineConstants>$(DefineConstants);NAVIS2027</DefineConstants>
    <NavisworksInstallDir Condition="'$(NavisworksInstallDir)' == ''">C:\Program Files\Autodesk\Navisworks Manage 2027</NavisworksInstallDir>
  </PropertyGroup>

  <Target Name="ValidateNavisworksReferences" BeforeTargets="ResolveReferences" Condition="'$(SkipNavisworksReferenceCheck)' != 'true'">
    <Error Condition="!Exists('$(NavisworksInstallDir)\Autodesk.Navisworks.Api.dll')"
           Text="Navisworks API not found at $(NavisworksInstallDir). Pass /p:NavisworksInstallDir=&quot;C:\Program Files\Autodesk\Navisworks Manage 2027&quot; or /p:SkipNavisworksReferenceCheck=true for project-shape checks." />
  </Target>

  <ItemGroup>
    <Reference Include="Autodesk.Navisworks.Api">
      <HintPath>$(NavisworksInstallDir)\Autodesk.Navisworks.Api.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Autodesk.Navisworks.Controls">
      <HintPath>$(NavisworksInstallDir)\Autodesk.Navisworks.Controls.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AdWindows">
      <HintPath>$(NavisworksInstallDir)\AdWindows.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="navisworks.gui.roamer">
      <HintPath>$(NavisworksInstallDir)\navisworks.gui.roamer.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="4.8.0" />
    <PackageReference Include="IsExternalInit" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\shared\**\*.cs" LinkBase="Shared" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\shared\Plugin\NwdRibbon.xaml">
      <LogicalName>NwdRibbon.xaml</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
